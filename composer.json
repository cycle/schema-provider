    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/container": "^1.1.2 || ^2.0.2",
        "webmozart/glob": "^4.7",
        "spiral/files": "^3.14",
        "cycle/orm": "^2.18",
        "cycle/schema-renderer": "^1.4"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.48",
        "vimeo/psalm": "^6.13",
        "yiisoft/test-support": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Cycle\\Schema\\Provider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Schema\\Provider\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
