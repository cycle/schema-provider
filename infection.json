{
    "$schema": "vendor-bin/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "minMsi": 98,
    "minCoveredMsi": 98,
    "testFramework": "testo",
    "testFrameworkOptions": "--suite=Unit",
    "tmpDir": "runtime",
    "logs": {
        "stryker": {
            "report": "1.x"
        }
    },
    "mutators": {
        "@default": true,
        "Coalesce": {
            "ignore": [
                "Cycle\\Schema\\Provider\\Support\\DeferredSchemaProviderDecorator::read"
            ]
        },
        "TrueValue": {
            "ignore": [
                "Cycle\\Schema\\Provider\\PhpFileSchemaProvider::write::108"
            ]
        }
    }
}
